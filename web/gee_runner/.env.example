# 自动运行使用服务账号认证。
GEE_AUTH=service-account

# 服务账号模式需要以下两项。不要提交私钥文件。
# GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_FILE=./service-account.json
# 服务账号不能写入 Google Drive；Cloud Storage 导出需要一个已授权的 bucket。
# GEE_EXPORT_BUCKET=your-gcs-bucket-name
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com
# 也可以不在此处配置 API；程序会读取 %USERPROFILE%\.codex\auth.json 和 config.toml。

# 若需要通过本地 HTTP 代理访问 Google，请取消注释并修改端口。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
