// Landsat 8 改进型归一化水体指数 (MNDWI) 计算
var point = ee.Geometry.Point([114.28, 30.57]);[cite: 89]

var lc08 = ee.ImageCollection('LANDSAT/LC08/C02/T1_TOA')
  .filterBounds(point)
  .filterDate('2015-09-15', '2015-10-15')
  .sort('CLOUD_COVER')
  .first();

// MNDWI = (Green - SWIR1) / (Green + SWIR1)
var mndwi = lc08.normalizedDifference(['B3', 'B6']);[cite: 89]

var vis_params = {
  min: -0.8, 
  max: 0.8, 
  palette: ['gold', 'yellow', 'brown', 'lightblue', 'blue'][cite: 89]
};

Map.setCenter(114.28, 30.57, 9);[cite: 89]
Map.addLayer(mndwi, vis_params, 'MNDWI');[cite: 89]